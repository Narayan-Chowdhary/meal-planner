# Copy this file to `.env` and fill in the values.
# Only variables prefixed with VITE_ are exposed to the browser bundle,
# so never put server-side secrets here.

# json-server mock API (see `npm run server`)
VITE_API_BASE_URL=http://localhost:8000/

# Google OAuth client ID (https://console.cloud.google.com/apis/credentials)
VITE_GOOGLE_CLIENT_ID=

# Firebase Realtime Database (notifications)
VITE_FIREBASE_DATABASE_URL=

# Cloudinary unsigned upload endpoint
VITE_CLOUDINARY_UPLOAD_URL=

# Razorpay test key (public key id only)
VITE_RAZORPAY_KEY_ID=
